{
  "manifest_version": 3,
  "name": "Social Sweep - Instagram Helper",
  "version": "0.2.0",
  "description": "Instagram takipçi ve takip edilen listelerindeki görünür hesapları Social Sweep'e aktarır.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["https://www.instagram.com/*", "http://localhost:5173/*", "http://127.0.0.1:5173/*"],
  "action": { "default_title": "Social Sweep: Görünür listeyi aktar" },
  "background": { "service_worker": "background.js" }
}